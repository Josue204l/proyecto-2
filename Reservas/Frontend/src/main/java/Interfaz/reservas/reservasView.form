<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Interfaz.reservas.reservasView">
  <grid id="27dc6" binding="reservaspanel" layout-manager="GridLayoutManager" row-count="2" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="10">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="850" height="650"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>

      <!-- SECCION SUPERIOR: NUEVA RESERVA -->
      <grid id="formPanel" layout-manager="GridLayoutManager" row-count="5" column-count="5" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="8">
        <margin top="10" left="15" bottom="10" right="15"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="0" fill="1" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Nueva reserva"/>
        <children>

          <!-- Fila 1: Frase y Boton Extraer -->
          <component id="a10a1" class="javax.swing.JLabel">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="9" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Frase"/>
            </properties>
          </component>
          
          <!-- JScrollPane + JTextArea configurado con binding correcto -->
          <scrollpane id="scrollFrase">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="3" vsize-policy="3" hsize-policy="6" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="50"/>
              </grid>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="89102" class="javax.swing.JTextArea" binding="txtFrase">
                <constraints/>
                <properties>
                  <lineWrap value="true"/>
                  <wrapStyleWord value="true"/>
                </properties>
              </component>
            </children>
          </scrollpane>

          <component id="72192" class="javax.swing.JButton" binding="extraerButton">
            <constraints>
              <grid row="0" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="1" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Extraer"/>
            </properties>
          </component>

          <!-- Fila 2: Actividad -->
          <component id="91823" class="javax.swing.JLabel">
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Actividad"/>
            </properties>
          </component>
          <component id="38210" class="javax.swing.JTextField" binding="txtActividad">
            <constraints>
              <grid row="1" column="1" row-span="1" col-span="4" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
          </component>

          <!-- Fila 3: Fecha + Hora Inicio -->
          <component id="10293" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Fecha"/>
            </properties>
          </component>
          <component id="19203" class="javax.swing.JTextField" binding="txtFecha">
            <constraints>
              <grid row="2" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                <preferred-size width="180" height="-1"/>
              </grid>
            </constraints>
            <properties/>
          </component>
          <component id="48102" class="javax.swing.JButton" binding="btnSeleccionarFecha">
            <constraints>
              <grid row="2" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="..."/>
            </properties>
          </component>
          <component id="48192" class="javax.swing.JLabel">
            <constraints>
              <grid row="2" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Hora inicio"/>
            </properties>
          </component>
          <grid id="pInicio" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="5" vgap="0">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="2" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="29103" class="javax.swing.JTextField" binding="txtHoraInicio">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="120" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="88102" class="javax.swing.JButton" binding="btnHoraInicio">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="▼"/>
                </properties>
              </component>
            </children>
          </grid>

          <!-- Fila 4: Categorias Requeridas + Hora Fin -->
          <component id="88201" class="javax.swing.JLabel">
            <constraints>
              <grid row="3" column="0" row-span="1" col-span="3" vsize-policy="0" hsize-policy="0" anchor="8" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Categorías requeridas (selección múltiple)"/>
            </properties>
          </component>
          <component id="59102" class="javax.swing.JLabel">
            <constraints>
              <grid row="3" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="4" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Hora fin"/>
            </properties>
          </component>
          <grid id="pFin" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="5" vgap="0">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="3" column="4" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="8" fill="1" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="txtFinField" class="javax.swing.JTextField" binding="txtHoraFin">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="6" anchor="8" fill="1" indent="0" use-parent-layout="false">
                    <preferred-size width="120" height="-1"/>
                  </grid>
                </constraints>
                <properties/>
              </component>
              <component id="66102" class="javax.swing.JButton" binding="btnHoraFin">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="▼"/>
                </properties>
              </component>
            </children>
          </grid>

          <!-- Fila 5: Lista de Categorias + Botones Reservar / Cancelar / Limpiar -->
          <scrollpane id="11029">
            <constraints>
              <grid row="4" column="0" row-span="1" col-span="3" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="100"/>
              </grid>
            </constraints>
            <properties/>
            <border type="etched" title="Categorías"/>
            <children>
              <component id="99102" class="javax.swing.JList" binding="listCategorias">
                <constraints/>
                <properties/>
              </component>
            </children>
          </scrollpane>

          <grid id="btnPanel" layout-manager="GridLayoutManager" row-count="1" column-count="3" same-size-horizontally="false" same-size-vertically="false" hgap="8" vgap="0">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="4" column="3" row-span="1" col-span="2" vsize-policy="0" hsize-policy="3" anchor="6" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="55102" class="javax.swing.JButton" binding="reservasButton">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Reservar"/>
                </properties>
              </component>
              <component id="11202" class="javax.swing.JButton" binding="cancelarReservaSelecionadaButton">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Cancelar reserva seleccionada"/>
                </properties>
              </component>
              <component id="44102" class="javax.swing.JButton" binding="LImpiarButton">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Limpiar"/>
                </properties>
              </component>
            </children>
          </grid>

        </children>
      </grid>

      <!-- SECCION INFERIOR: MIS RESERVAS -->
      <grid id="gridMisReservas" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="false" same-size-vertically="false" hgap="10" vgap="0">
        <margin top="0" left="0" bottom="0" right="0"/>
        <constraints>
          <grid row="1" column="0" row-span="1" col-span="2" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Mis reservas"/>
        <children>
          <scrollpane id="77201">
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="none"/>
            <children>
              <component id="22102" class="javax.swing.JTable" binding="tableMisReservas">
                <constraints/>
                <properties/>
              </component>
            </children>
          </scrollpane>
          <component id="99201" class="javax.swing.JButton" binding="imprimirButton">
            <constraints>
              <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties>
              <text value="Imprimir"/>
            </properties>
          </component>
        </children>
      </grid>

    </children>
  </grid>
</form>