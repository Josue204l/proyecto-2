<?xml version="1.0" encoding="UTF-8"?>
<form xmlns="http://www.intellij.com/uidesigner/form/" version="1" bind-to-class="Interfaz.estadisticas.estadisticasView">
  <grid id="27dc6" binding="mainPanel" default-binding="true" layout-manager="GridLayoutManager" row-count="1" column-count="2" same-size-horizontally="true" same-size-vertically="true" hgap="10" vgap="10">
    <margin top="10" left="10" bottom="10" right="10"/>
    <constraints>
      <xy x="20" y="20" width="1000" height="600"/>
    </constraints>
    <properties/>
    <border type="none"/>
    <children>

      <!-- BLOQUE IZQUIERDO: RECURSOS -->
      <grid id="3438b" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="5">
        <margin top="5" left="5" bottom="5" right="5"/>
        <constraints>
          <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Recursos"/>
        <children>

          <!-- Fechas Desde y Hasta -->
          <grid id="b54cb" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="5" vgap="-1">
            <margin top="5" left="5" bottom="5" right="5"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="etched" title="Fechas Desde y Hasta"/>
            <children>
              <grid id="r_from" binding="panelRecursosDesde" layout-manager="BorderLayout">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children/>
              </grid>
              <grid id="r_to" binding="panelRecursosHasta" layout-manager="BorderLayout">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children/>
              </grid>
              <component id="deedf" class="javax.swing.JButton" binding="btnCargarRecursos">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Cargar"/>
                </properties>
              </component>
              <component id="pdfRecursos" class="javax.swing.JButton" binding="btnPdfRecursos">
                <constraints>
                  <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Imprimir"/>
                </properties>
              </component>
            </children>
          </grid>

          <!-- Panel Tabla Estadísticas -->
          <grid id="694e4" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="130"/>
              </grid>
            </constraints>
            <properties/>
            <border type="etched" title="Estadísticas"/>
            <children>
              <scrollpane id="scrollRecursos">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="4b4a8" class="javax.swing.JTable" binding="tableRecursos"/>
                </children>
              </scrollpane>
            </children>
          </grid>

          <!-- Panel Gráfico -->
          <grid id="7806b" binding="chartRecursos" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="230"/>
              </grid>
            </constraints>
            <properties/>
            <border type="etched" title="Gráfico"/>
            <children/>
          </grid>

        </children>
      </grid>

      <!-- BLOQUE DERECHO: ACTIVIDADES -->
      <grid id="4db7a" layout-manager="GridLayoutManager" row-count="3" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="5">
        <margin top="5" left="5" bottom="5" right="5"/>
        <constraints>
          <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
        </constraints>
        <properties/>
        <border type="etched" title="Actividades"/>
        <children>

          <!-- Fechas Desde y Hasta -->
          <grid id="b4c41" layout-manager="GridLayoutManager" row-count="1" column-count="4" same-size-horizontally="false" same-size-vertically="false" hgap="5" vgap="-1">
            <margin top="5" left="5" bottom="5" right="5"/>
            <constraints>
              <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
            </constraints>
            <properties/>
            <border type="etched" title="Fechas Desde y Hasta"/>
            <children>
              <grid id="a_from" binding="panelActividadesDesde" layout-manager="BorderLayout">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children/>
              </grid>
              <grid id="a_to" binding="panelActividadesHasta" layout-manager="BorderLayout">
                <constraints>
                  <grid row="0" column="1" row-span="1" col-span="1" vsize-policy="0" hsize-policy="3" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children/>
              </grid>
              <component id="4a831" class="javax.swing.JButton" binding="btnCargarActividades">
                <constraints>
                  <grid row="0" column="2" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Cargar"/>
                </properties>
              </component>
              <component id="pdfActividades" class="javax.swing.JButton" binding="btnPdfActividades">
                <constraints>
                  <grid row="0" column="3" row-span="1" col-span="1" vsize-policy="0" hsize-policy="0" anchor="0" fill="0" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties>
                  <text value="Imprimir"/>
                </properties>
              </component>
            </children>
          </grid>

          <!-- Panel Tabla Estadísticas -->
          <grid id="b7c9" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="1" column="0" row-span="1" col-span="1" vsize-policy="3" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="130"/>
              </grid>
            </constraints>
            <properties/>
            <border type="etched" title="Estadísticas"/>
            <children>
              <scrollpane id="scrollActividades">
                <constraints>
                  <grid row="0" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false"/>
                </constraints>
                <properties/>
                <border type="none"/>
                <children>
                  <component id="82e3f" class="javax.swing.JTable" binding="tableActividades"/>
                </children>
              </scrollpane>
            </children>
          </grid>

          <!-- Panel Gráfico -->
          <grid id="97194" binding="chartActividades" layout-manager="GridLayoutManager" row-count="1" column-count="1" same-size-horizontally="false" same-size-vertically="false" hgap="-1" vgap="-1">
            <margin top="0" left="0" bottom="0" right="0"/>
            <constraints>
              <grid row="2" column="0" row-span="1" col-span="1" vsize-policy="7" hsize-policy="7" anchor="0" fill="3" indent="0" use-parent-layout="false">
                <preferred-size width="-1" height="230"/>
              </grid>
            </constraints>
            <properties/>
            <border type="etched" title="Gráfico"/>
            <children/>
          </grid>

        </children>
      </grid>

    </children>
  </grid>
</form>